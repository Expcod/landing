[Unit]
Description=Nova Code landing backend (Django)
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/landing-back
ExecStart=/var/www/landing-back/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8040 --workers 2
Restart=always

[Install]
WantedBy=multi-user.target
